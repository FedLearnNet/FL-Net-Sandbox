# Change these to the locally build images you want to test with
# The repositories should all have dev_scripts/build_local_docker_image.sh
# You can check these scripts to see the image names they produce
# Please use either the :tmptag or :testingtag
ORCH_API_IMAGE=ghcr.io/fedlearnnet/orchestration-api/orch-api:staging
#ORCH_API_IMAGE=orch-api:testingtag
LOCAL_LEARNING_API_IMAGE=ghcr.io/fedlearnnet/learning-apis/local-learning-api:staging
#LOCAL_LEARNING_API_IMAGE=local-learning-api:testingtag
GLOBAL_LEARNING_API_IMAGE=ghcr.io/fedlearnnet/learning-apis/global-learning-api:staging
#GLOBAL_LEARNING_API_IMAGE=global-learning-api:testingtag
DATAMODELER_API_IMAGE=ghcr.io/fedlearnnet/learning-apis/datamodeler-api:staging
#DATAMODELER_API_IMAGE=datamodeler-api:testingtag
CONTROLLER_IMAGE=ghcr.io/fedlearnnet/federated-learning-communication-api/controller:staging
#CONTROLLER_IMAGE=controller:testingtag
RELAY_SERVER_IMAGE=ghcr.io/fedlearnnet/federated-learning-communication-api/controller-relay:staging
#RELAY_SERVER_IMAGE=controller-relay:testingtag
LOCAL_FRONTEND_IMAGE=ghcr.io/fedlearnnet/frontends/local-fl-net:staging
#LOCAL_FRONTEND_IMAGE=local-fl-net:testingtag
GLOBAL_FRONTEND_IMAGE=ghcr.io/fedlearnnet/frontends/global-fl-net:staging
#GLOBAL_FRONTEND_IMAGE=global-fl-net:testingtag
PIPELINE_BUILDER_IMAGE=ghcr.io/fedlearnnet/tool-build-pipeline/pipeline:staging
# The pipeline build image is checked to be of an allowed registry in the
# orch-api
# This is why even the image for testing needs to be in the ghcr.io/fedlearnnet registry
# Please do not push the image though
#PIPELINE_BUILDER_IMAGE=ghcr.io/fedlearnnet/tool-build-pipeline/pipeline:testingtag
